{
  "name": "kup-pogode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply kup-pogode --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kup-pogode --local",
    "db:migrate:remote": "wrangler d1 migrations apply kup-pogode --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.13.22",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.168.0"
  }
}
